# InsightFlow AI Configuration
# Copy this file to .env or set environment variables in your deployment environment.

# Google Gemini API Configuration (Official Google Gen AI SDK)
# Required for live LLM multi-step tool calling and multimodal document extraction.
# If omitted or left blank, the application automatically uses the verified deterministic analytical engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-3.5-flash-lite)
# Supported multimodal options: gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Maximum tool-calling iterations per turn (Default: 5)
GEMINI_MAX_ITERATIONS=5

# Database Connection URL
# Default (local SQLite): sqlite:///./insightflow.db
# External PostgreSQL (e.g. Supabase, Neon, AWS RDS, Render):
# DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/postgres?sslmode=require
# External MySQL:
# DATABASE_URL=mysql://username:password@hostname:3306/dbname
DATABASE_URL=sqlite:///./insightflow.db
